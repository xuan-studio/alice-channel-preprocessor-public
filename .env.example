# Public, non-secret settings. Copy to .env or use ./scripts/setup.sh.
APP_ENV=portable
APP_NAME=Telegram 频道预处理台
DEMO_MODE=0
TELEGRAM_WORKER_ENABLED=1
PUBLIC_BASE_URL=http://127.0.0.1:8848
TRUSTED_HOSTS=127.0.0.1,localhost
SESSION_COOKIE_SECURE=0
WEB_HOST=127.0.0.1
WEB_PORT=8848

# Initial authenticated administrator. Store its 16+ character password in
# secrets/platform_bootstrap_password.
PLATFORM_BOOTSTRAP_USERNAME=admin
SESSION_DAYS=14
# PLATFORM_BOOTSTRAP_PASSWORD is intentionally not stored here.
# PLATFORM_BOOTSTRAP_PASSWORD_FILE=/run/secrets/platform_bootstrap_password

# SQLite is used when both DATABASE_URL and DATABASE_HOST are empty.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=preprocessor
DATABASE_NAME=channel_preprocessor
# DATABASE_PASSWORD is intentionally not stored here.
# DATABASE_PASSWORD_FILE=/run/secrets/database_password

# Create your own Telegram application at https://my.telegram.org/apps.
# Store its API hash in secrets/telegram_api_hash.
TELEGRAM_API_ID=YOUR_TELEGRAM_API_ID
TELEGRAM_ACCOUNT_NAME=collector
TELEGRAM_ACCOUNT_DIR=
CHAT_EXPORT_ACCOUNT_NAME=
# TELEGRAM_API_HASH is intentionally not stored here.
# TELEGRAM_API_HASH_FILE=/run/secrets/telegram_api_hash
# TELEGRAM_DATABASE_PASSPHRASE is intentionally not stored here.
# TELEGRAM_DATABASE_PASSPHRASE_FILE=/run/secrets/telegram_database_passphrase

# Optional standby collector. Leave its secret file empty to disable failover.
TELEGRAM_STANDBY_ACCOUNT_NAME=standby
TELEGRAM_STANDBY_ACCOUNT_DIR=
COLLECTOR_FAILOVER_THRESHOLD=2
COLLECTOR_RECOVERY_SECONDS=900
# TELEGRAM_STANDBY_DATABASE_PASSPHRASE_FILE=/run/secrets/telegram_standby_database_passphrase

# Optional workgroup bot. Store its token in secrets/telegram_bot_token.
# Keep disabled until chat/user allowlists are configured.
BOT_ENABLED=0
TELEGRAM_WORKGROUP_CHAT_ID=0
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_BOT_TOKEN is intentionally not stored here.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token

# Optional OpenAI-compatible analysis. Store its key in secrets/ai_api_key.
AI_ENABLED=0
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_MAX_SOURCES=30
# AI_API_KEY is intentionally not stored here.
# AI_API_KEY_FILE=/run/secrets/ai_api_key

# Existing protected API for a separately deployed trusted frontend.
TEAM_SITE_URL=
# SITE_PROXY_TOKEN is intentionally not stored here.
# SITE_PROXY_TOKEN_FILE=/run/secrets/site_proxy_token

# Optional local SOCKS5 binding.
TELEGRAM_REQUIRE_PROXY=0
TELEGRAM_PROXY_LINE_KEY=
TELEGRAM_PROXY_HOST=127.0.0.1
TELEGRAM_PROXY_PORT=0
TELEGRAM_PROXY_EXIT_FINGERPRINT=

RAW_RETENTION_DAYS=7
RESULT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
SCAN_CACHE_HOURS=24
MAX_POSTS=100
MAX_GROUP_MESSAGES=5000
GROUP_ACTIVE_USER_LIMIT=50
GROUP_AD_SAMPLE_MESSAGES=80
INACTIVE_DAYS=90
MAX_PINNED=20
MAX_COMMENTS_PER_POST=1000
MAX_COMMENTS_PER_JOB=10000
MAX_NEW_JOINS_PER_DAY=20
WORKER_POLL_SECONDS=3

# Advanced host/runtime overrides; normally leave empty in Docker.
TDLIB_JSON_LIBRARY=
TDLIB_CORE_PATH=
TELEGRAM_ACCOUNT_BINDING_FILE=
TELEGRAM_PROXY_BINDING_FILE=
HISTORY_EXPORT_ACCOUNT_NAME=
HISTORY_EXPORT_ACCOUNT_DIR=
HISTORY_EXPORT_OUTPUT_DIR=

# RESET_CONFIG=1 is a one-shot shell option for scripts/setup.sh, not a saved secret.
